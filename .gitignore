# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Environment / secrets ──────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Distribution / packaging ───────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Testing ────────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Type checking ──────────────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── Alembic ────────────────────────────────────────────────────────────────────
# Keep migrations/versions tracked — they are part of your source history.
# Only ignore auto-generated __pycache__ inside migrations.
migrations/__pycache__/
migrations/versions/__pycache__/

# ── IDE / editors ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
